<%- include('layout-top', {title:'Pages', path:'/admin/pages', user, messages}) %>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Page</th><th>Slug</th><th>Last Updated</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr>
        <td class="fw-semibold"><%= item.title %></td>
        <td><code>/<%= item.slug %></code></td>
        <td><%= new Date(item.updated_at).toLocaleDateString('en-GB') %></td>
        <td>
          <a href="/admin/pages/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
          <a href="/<%= item.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="4" class="text-center text-muted py-4">No pages yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
