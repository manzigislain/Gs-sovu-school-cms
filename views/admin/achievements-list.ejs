<%- include('layout-top', {title:'Achievements', path:'/admin/achievements', user, messages}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Achievements</h5>
  <a href="/admin/achievements/new" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Achievement</a>
</div>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Title</th><th>Year</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr>
        <td class="fw-semibold"><%= item.title %></td>
        <td><%= item.year || '-' %></td>
        <td><span class="badge <%= item.active?'bg-success':'bg-secondary' %>"><%= item.active?'Active':'Hidden' %></span></td>
        <td>
          <a href="/admin/achievements/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
          <form action="/admin/achievements/<%= item.id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="4" class="text-center text-muted py-4">No achievements yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
