<%- include('layout-top', {title:'Hero Slides', path:'/admin/slides', user, messages}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Hero Slides</h5>
  <a href="/admin/slides/new" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Slide</a>
</div>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Image</th><th>Title</th><th>Subtitle</th><th>Order</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr>
        <td><img src="<%= item.image_url %>" style="width:80px;height:50px;object-fit:cover;border-radius:6px" alt="slide"></td>
        <td class="fw-semibold"><%= item.title %></td>
        <td class="text-muted small"><%= item.subtitle ? item.subtitle.substring(0,50)+'...' : '' %></td>
        <td><%= item.sort_order %></td>
        <td><span class="badge <%= item.active?'bg-success':'bg-secondary' %>"><%= item.active?'Active':'Hidden' %></span></td>
        <td>
          <a href="/admin/slides/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
          <form action="/admin/slides/<%= item.id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="6" class="text-center text-muted py-4">No slides yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
