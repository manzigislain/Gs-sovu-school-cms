<%- include('layout-top', {title:'Downloads', path:'/admin/downloads', user, messages}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Downloads & Documents</h5>
  <a href="/admin/downloads/new" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Upload Document</a>
</div>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Title</th><th>Category</th><th>File</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr>
        <td class="fw-semibold"><%= item.title %></td>
        <td><%= item.category || '-' %></td>
        <td><a href="<%= item.file_url %>" target="_blank" class="text-primary small"><i class="fas fa-file-pdf me-1 text-danger"></i>View</a></td>
        <td><span class="badge <%= item.active?'bg-success':'bg-secondary' %>"><%= item.active?'Active':'Hidden' %></span></td>
        <td><%= new Date(item.created_at).toLocaleDateString('en-GB') %></td>
        <td>
          <a href="/admin/downloads/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
          <form action="/admin/downloads/<%= item.id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="6" class="text-center text-muted py-4">No documents uploaded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
