<%- include('layout-top', {title:'View Message', path:'/admin/messages', user, messages}) %>
<div class="admin-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h5>Message from <%= item.full_name %></h5>
    <a href="/admin/messages" class="btn btn-sm btn-outline-secondary">← Back</a>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-6"><strong>Name:</strong> <%= item.full_name %></div>
    <div class="col-md-6"><strong>Email:</strong> <a href="mailto:<%= item.email %>"><%= item.email %></a></div>
    <div class="col-md-6"><strong>Subject:</strong> <%= item.subject || '-' %></div>
    <div class="col-md-6"><strong>Date:</strong> <%= new Date(item.created_at).toLocaleString('en-GB') %></div>
  </div>
  <div class="p-3 rounded mb-4" style="background:var(--light)">
    <strong>Message:</strong>
    <p class="mt-2 mb-0"><%= item.message %></p>
  </div>
  <% if (item.attachment_url) { %>
  <p><strong>Attachment:</strong> <a href="<%= item.attachment_url %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-paperclip me-1"></i>View Attachment</a></p>
  <% } %>
  <a href="mailto:<%= item.email %>?subject=Re: <%= item.subject %>" class="btn btn-primary me-2"><i class="fas fa-reply me-2"></i>Reply via Email</a>
  <form action="/admin/messages/<%= item.id %>/delete" method="POST" class="d-inline">
    <button type="submit" class="btn btn-outline-danger btn-delete"><i class="fas fa-trash me-2"></i>Delete</button>
  </form>
</div>
<%- include('layout-bottom') %>
