<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body style="background:#f0f2f5;display:flex;align-items:center;justify-content:center;min-height:100vh">
  <div class="text-center">
    <i class="fas fa-exclamation-triangle fa-4x text-warning mb-3"></i>
    <h3 class="fw-bold"><%= title %></h3>
    <p class="text-muted"><%= message %></p>
    <a href="/admin/login" class="btn btn-primary mt-3"><i class="fas fa-sign-in-alt me-2"></i>Go to Login</a>
    <a href="/" class="btn btn-outline-secondary mt-3 ms-2">Back to Website</a>
  </div>
</body>
</html>
