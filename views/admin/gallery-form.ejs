<%- include('layout-top', {title: item ? 'Edit Image' : 'Add Image', path:'/admin/gallery', user, messages}) %>
<div class="admin-card">
  <h5><%= item ? 'Edit Gallery Image' : 'Add Gallery Image' %></h5>
  <form action="<%= item ? '/admin/gallery/'+item.id+'/edit' : '/admin/gallery/new' %>" method="POST" enctype="multipart/form-data">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label fw-semibold">Title</label><input type="text" name="title" class="form-control" value="<%= item ? (item.title||'') : '' %>"></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Category</label><input type="text" name="category" class="form-control" placeholder="e.g. activities, sports, campus" value="<%= item ? (item.category||'') : '' %>"></div>
      <div class="col-12"><label class="form-label fw-semibold">Description</label><textarea name="description" class="form-control" rows="2"><%= item ? (item.description||'') : '' %></textarea></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Sort Order</label><input type="number" name="sort_order" class="form-control" value="<%= item ? item.sort_order : 0 %>"></div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Status</label>
        <select name="active" class="form-select">
          <option value="true" <%= !item || item.active ? 'selected' : '' %>>Active</option>
          <option value="false" <%= item && !item.active ? 'selected' : '' %>>Hidden</option>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Image</label>
        <input type="file" name="image" class="form-control" accept="image/*" <%= item ? '' : 'required' %>>
        <% if (item && item.image_url) { %>
        <img src="<%= item.image_url %>" class="mt-2 rounded" style="height:100px;object-fit:cover" alt="current">
        <input type="hidden" name="existing_image" value="<%= item.image_url %>">
        <% } %>
      </div>
      <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button>
        <a href="/admin/gallery" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </div>
  </form>
</div>
<%- include('layout-bottom') %>
