<%- include('layout-top', {title:'Contact Messages', path:'/admin/messages', user, messages}) %>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Name</th><th>Email</th><th>Subject</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr class="<%= !item.read ? 'fw-bold' : '' %>">
        <td><%= item.full_name %></td>
        <td><a href="mailto:<%= item.email %>"><%= item.email %></a></td>
        <td><%= item.subject ? item.subject.substring(0,40) : '-' %></td>
        <td><%= new Date(item.created_at).toLocaleDateString('en-GB') %></td>
        <td><span class="badge <%= item.read?'bg-secondary':'bg-danger' %>"><%= item.read?'Read':'New' %></span></td>
        <td>
          <a href="/admin/messages/<%= item.id %>" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-eye"></i></a>
          <form action="/admin/messages/<%= item.id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="6" class="text-center text-muted py-4">No messages yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
