<%- include('layout-top', {title:'Staff', path:'/admin/staff', user, messages}) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Staff Members</h5>
  <a href="/admin/staff/new" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Add Staff</a>
</div>
<div class="admin-table">
  <table class="table table-hover mb-0">
    <thead><tr><th>Photo</th><th>Name</th><th>Position</th><th>Department</th><th>Type</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (items && items.length) { items.forEach(item => { %>
      <tr>
        <td>
          <% if (item.image_url) { %>
          <img src="<%= item.image_url %>" class="rounded-circle" style="width:40px;height:40px;object-fit:cover" alt="">
          <% } else { %>
          <div style="width:40px;height:40px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:0.9rem"><i class="fas fa-user"></i></div>
          <% } %>
        </td>
        <td class="fw-semibold"><%= item.name %></td>
        <td><%= item.position || '-' %></td>
        <td><%= item.department || '-' %></td>
        <td><span class="badge bg-secondary"><%= item.staff_type %></span></td>
        <td>
          <a href="/admin/staff/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
          <form action="/admin/staff/<%= item.id %>/delete" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }) } else { %>
      <tr><td colspan="6" class="text-center text-muted py-4">No staff members yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('layout-bottom') %>
