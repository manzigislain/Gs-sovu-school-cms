<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">Achievements</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Achievements</li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <% if (achievements && achievements.length) { %>
    <div class="row g-4">
      <% achievements.forEach(a => { %>
      <div class="col-lg-4 col-md-6 fade-in">
        <div class="card p-4 h-100">
          <div class="d-flex align-items-center gap-3 mb-3">
            <i class="fas fa-trophy fa-2x text-warning"></i>
            <div>
              <h6 class="fw-bold mb-0"><%= a.title %></h6>
              <small class="text-muted"><%= a.year %></small>
            </div>
          </div>
          <p class="text-muted small"><%= a.description %></p>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-trophy fa-4x text-muted mb-3"></i>
      <p class="text-muted">Achievements coming soon.</p>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
