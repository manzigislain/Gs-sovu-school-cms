<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">Parents (Babyeyi)</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Parents</li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-8 fade-in">
        <div class="admin-card mb-4">
          <h4 class="fw-bold mb-3" style="color:var(--primary)">Welcome, Parents!</h4>
          <p class="text-muted">This section is dedicated to parents and guardians of G.S. SOVU students. Here you will find important documents, school policies, and resources to help support your child's education.</p>
        </div>
        <% if (downloads && downloads.length) { %>
        <div class="admin-card">
          <h5 class="fw-bold mb-4" style="color:var(--primary)"><i class="fas fa-file-download me-2 text-warning"></i>Parent Documents</h5>
          <div class="row g-3">
            <% downloads.forEach(d => { %>
            <div class="col-md-6">
              <div class="d-flex align-items-center gap-3 p-3 rounded" style="background:var(--light)">
                <div style="width:45px;height:45px;background:#fff0f0;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <i class="fas fa-file-pdf text-danger"></i>
                </div>
                <div class="flex-grow-1">
                  <h6 class="fw-bold mb-0 small"><%= d.title %></h6>
                  <% if (d.description) { %><p class="text-muted mb-0" style="font-size:0.75rem"><%= d.description %></p><% } %>
                </div>
                <a href="<%= d.file_url %>" target="_blank" class="btn btn-sm btn-outline-danger"><i class="fas fa-download"></i></a>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } else { %>
        <div class="admin-card text-center py-4">
          <i class="fas fa-file-pdf fa-3x text-muted mb-3"></i>
          <p class="text-muted">Parent documents will be available soon.</p>
        </div>
        <% } %>
      </div>
      <div class="col-lg-4 fade-in">
        <div class="contact-info-card mb-4">
          <h5><i class="fas fa-phone me-2"></i>Contact School</h5>
          <p><a href="tel:<%= settings.school_phone1 %>" style="color:rgba(255,255,255,0.85)"><%= settings.school_phone1 %></a></p>
          <p><a href="tel:<%= settings.school_phone2 %>" style="color:rgba(255,255,255,0.85)"><%= settings.school_phone2 %></a></p>
          <p><a href="mailto:<%= settings.school_email %>" style="color:rgba(255,255,255,0.85)"><%= settings.school_email %></a></p>
        </div>
        <div class="admin-card">
          <h6 class="fw-bold mb-3" style="color:var(--primary)">Quick Links</h6>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="/requirements" class="text-decoration-none text-primary"><i class="fas fa-chevron-right me-2 text-warning small"></i>School Requirements</a></li>
            <li class="mb-2"><a href="/calendar" class="text-decoration-none text-primary"><i class="fas fa-chevron-right me-2 text-warning small"></i>School Calendar</a></li>
            <li class="mb-2"><a href="/faqs" class="text-decoration-none text-primary"><i class="fas fa-chevron-right me-2 text-warning small"></i>FAQs</a></li>
            <li class="mb-2"><a href="/contact" class="text-decoration-none text-primary"><i class="fas fa-chevron-right me-2 text-warning small"></i>Contact Us</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
