<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold"><%= article.title %></h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/news">News</a></li>
        <li class="breadcrumb-item active"><%= article.title %></li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="admin-card">
          <% if (article.image_url) { %>
          <img src="<%= article.image_url %>" class="img-fluid rounded-3 mb-4 w-100" style="max-height:400px;object-fit:cover" alt="<%= article.title %>">
          <% } %>
          <div class="d-flex align-items-center gap-3 mb-3">
            <span class="badge-category"><%= article.category || 'News' %></span>
            <span class="text-muted small"><i class="fas fa-calendar me-1"></i><%= new Date(article.created_at).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) %></span>
          </div>
          <h2 class="fw-bold mb-4"><%= article.title %></h2>
          <div class="article-content"><%- article.content %></div>
          <hr class="mt-4">
          <a href="/news" class="btn-primary-custom"><i class="fas fa-arrow-left me-2"></i>Back to News</a>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
