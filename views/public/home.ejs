<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- Announcement Ticker -->
<% if (announcements && announcements.length) { %>
<div class="announcement-bar">
  <div class="container d-flex align-items-center gap-3">
    <span class="fw-bold text-dark text-nowrap"><i class="fas fa-bullhorn me-2"></i>Announcements:</span>
    <div class="ticker-wrap flex-grow-1">
      <div class="ticker-content">
        <% announcements.forEach(a => { %> &nbsp;&nbsp;&nbsp;📢 <%= a.title %> &nbsp;&nbsp;&nbsp;|<% }) %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Hero Section -->
<section class="hero-section">
  <% slides.forEach((slide, i) => { %>
  <div class="hero-slide" style="background-image:url('<%= slide.image_url %>')">
    <div class="hero-overlay"></div>
  </div>
  <% }) %>
  <div class="hero-content container">
    <div class="col-lg-8">
      <% slides.forEach((slide, i) => { %>
      <div class="hero-text-slide" id="heroText<%= i %>" style="display:<%= i===0?'block':'none' %>">
        <p class="text-warning fw-bold mb-2" style="letter-spacing:2px;font-size:0.9rem"><i class="fas fa-cross me-2"></i>CATHOLIC GOVERNMENT-AIDED DAY SCHOOL</p>
        <h1><%= slide.title %></h1>
        <p class="mt-3 mb-4"><%= slide.subtitle %></p>
        <a href="<%= slide.button_link %>" class="btn-gold me-3"><%= slide.button_text %></a>
        <a href="/contact" class="btn-primary-custom" style="background:transparent;border-color:white;color:white">Contact Us</a>
      </div>
      <% }) %>
    </div>
  </div>
  <div class="hero-arrows">
    <button class="hero-arrow" id="heroPrev"><i class="fas fa-chevron-left"></i></button>
    <button class="hero-arrow" id="heroNext"><i class="fas fa-chevron-right"></i></button>
  </div>
  <div class="hero-indicators">
    <% slides.forEach((s, i) => { %><button class="hero-dot" data-index="<%= i %>"></button><% }) %>
  </div>
</section>

<!-- Stats Bar -->
<section style="background:linear-gradient(135deg,var(--primary),#2a5298);padding:40px 0">
  <div class="container">
    <div class="row text-center g-3">
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number counter" data-target="500" data-suffix="+">0</div>
          <div class="stat-label">Students</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number counter" data-target="40" data-suffix="+">0</div>
          <div class="stat-label">Teachers</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number counter" data-target="30" data-suffix="+">0</div>
          <div class="stat-label">Years of Excellence</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <div class="stat-number counter" data-target="95" data-suffix="%">0</div>
          <div class="stat-label">Pass Rate</div>
        </div>
      </div>
    </div>
  </div>
</section>

