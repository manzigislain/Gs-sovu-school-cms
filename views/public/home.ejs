<!-- Latest News -->
<% if (news && news.length) { %>
<section class="py-5 section-bg">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5 fade-in">
      <div>
        <p class="text-warning fw-bold mb-1" style="letter-spacing:2px;font-size:0.85rem">STAY INFORMED</p>
        <h2 class="section-title text-start">Latest News</h2>
      </div>
      <a href="/news" class="btn-primary-custom">View All</a>
    </div>
    <div class="row g-4">
      <% news.forEach(item => { %>
      <div class="col-lg-4 col-md-6 fade-in">
        <div class="card news-card h-100">
          <% if (item.image_url) { %>
          <img src="<%= item.image_url %>" class="card-img-top" alt="<%= item.title %>">
          <% } else { %>
          <div style="height:200px;background:linear-gradient(135deg,var(--primary),#2a5298);display:flex;align-items:center;justify-content:center">
            <i class="fas fa-newspaper fa-3x text-warning"></i>
          </div>
          <% } %>
          <div class="card-body">
            <span class="badge-category"><%= item.category || 'News' %></span>
            <h6 class="fw-bold mt-2"><%= item.title %></h6>
            <p class="text-muted small"><%= item.excerpt ? item.excerpt.substring(0,100) + '...' : '' %></p>
          </div>
          <div class="card-footer bg-transparent border-0 pb-3">
            <a href="/news/<%= item.slug %>" class="text-primary fw-semibold small">Read More <i class="fas fa-arrow-right ms-1"></i></a>
            <span class="text-muted small float-end"><%= new Date(item.created_at).toLocaleDateString('en-GB') %></span>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Upcoming Events -->
<% if (events && events.length) { %>
