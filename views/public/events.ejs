<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">Upcoming Events</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Events</li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <% if (events && events.length) { %>
    <div class="row g-4">
      <% events.forEach(ev => { %>
      <div class="col-lg-4 col-md-6 fade-in">
        <div class="card h-100">
          <% if (ev.image_url) { %>
          <img src="<%= ev.image_url %>" class="card-img-top" alt="<%= ev.title %>">
          <% } %>
          <div class="card-body">
            <div class="d-flex gap-3 mb-3">
              <div style="min-width:60px;height:60px;background:var(--primary);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:white;flex-shrink:0">
                <span style="font-size:1.3rem;font-weight:800;line-height:1"><%= new Date(ev.event_date).getDate() %></span>
                <span style="font-size:0.65rem;text-transform:uppercase"><%= new Date(ev.event_date).toLocaleString('en',{month:'short'}) %></span>
              </div>
              <div>
                <h6 class="fw-bold mb-1"><%= ev.title %></h6>
                <p class="text-muted small mb-1"><i class="fas fa-map-marker-alt me-1 text-warning"></i><%= ev.location %></p>
                <% if (ev.event_time) { %><p class="text-muted small"><i class="fas fa-clock me-1 text-warning"></i><%= ev.event_time %></p><% } %>
              </div>
            </div>
            <p class="text-muted small"><%= ev.description %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-calendar fa-4x text-muted mb-3"></i>
      <p class="text-muted">No upcoming events at this time.</p>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
