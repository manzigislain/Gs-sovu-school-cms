<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">Announcements</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Announcements</li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <% if (announcements && announcements.length) { %>
    <div class="row g-4">
      <% announcements.forEach(a => { %>
      <div class="col-lg-6 fade-in">
        <div class="card h-100 p-4">
          <div class="d-flex align-items-start gap-3">
            <div style="width:45px;height:45px;background:<%= a.priority==='high'?'var(--danger)':'var(--primary)' %>;border-radius:10px;display:flex;align-items:center;justify-content:center;color:white;flex-shrink:0">
              <i class="fas fa-bullhorn"></i>
            </div>
            <div>
              <% if (a.priority === 'high') { %><span class="badge bg-danger mb-1">Important</span><% } %>
              <h6 class="fw-bold mb-1"><%= a.title %></h6>
              <p class="text-muted small mb-1"><%= a.content %></p>
              <small class="text-muted"><i class="fas fa-calendar me-1"></i><%= new Date(a.created_at).toLocaleDateString('en-GB') %></small>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-bullhorn fa-4x text-muted mb-3"></i>
      <p class="text-muted">No announcements at this time.</p>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
