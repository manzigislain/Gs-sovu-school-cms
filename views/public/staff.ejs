<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">Teaching Staff</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">Staff</li>
      </ol>
    </nav>
  </div>
</div>
<section class="py-5">
  <div class="container">
    <% if (staff && staff.length) { %>
    <div class="row g-4">
      <% staff.forEach(s => { %>
      <div class="col-lg-3 col-md-4 col-6 fade-in">
        <div class="card text-center p-3 h-100">
          <% if (s.image_url) { %>
          <img src="<%= s.image_url %>" class="rounded-circle mx-auto mb-3" style="width:90px;height:90px;object-fit:cover" alt="<%= s.name %>">
          <% } else { %>
          <div style="width:90px;height:90px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;margin:0 auto 15px">
            <i class="fas fa-user-tie"></i>
          </div>
          <% } %>
          <h6 class="fw-bold mb-1"><%= s.name %></h6>
          <p class="text-warning small fw-semibold mb-1"><%= s.position %></p>
          <% if (s.department) { %><p class="text-muted small mb-0"><%= s.department %></p><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-users fa-4x text-muted mb-3"></i>
      <p class="text-muted">Staff information coming soon.</p>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
