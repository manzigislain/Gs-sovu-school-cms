<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="breadcrumb-section">
  <div class="container">
    <h1 class="fw-bold">About Us</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active">About Us</li>
      </ol>
    </nav>
  </div>
</div>

<section class="py-5">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 fade-in">
        <p class="text-warning fw-bold mb-1" style="letter-spacing:2px;font-size:0.85rem"><i class="fas fa-cross me-2"></i>WHO WE ARE</p>
        <h2 class="section-title text-start">About <%= settings.school_name %></h2>
        <p class="text-muted mt-3"><%= settings.about_intro %></p>
        <p class="text-muted"><%= settings.school_type %></p>
      </div>
      <div class="col-lg-6 fade-in">
        <img src="/uploads/images/gallery5.jpg" class="img-fluid rounded-3 shadow" alt="School">
      </div>
    </div>
  </div>
</section>

<section class="py-5 section-bg" id="mission">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4 fade-in">
        <div class="why-card text-center">
          <div class="why-icon"><i class="fas fa-bullseye"></i></div>
          <h5 class="fw-bold mt-3">Our Mission</h5>
          <p class="text-muted small"><%= settings.mission %></p>
        </div>
      </div>
      <div class="col-lg-4 fade-in">
        <div class="why-card text-center">
          <div class="why-icon"><i class="fas fa-eye"></i></div>
          <h5 class="fw-bold mt-3">Our Vision</h5>
          <p class="text-muted small"><%= settings.vision %></p>
        </div>
      </div>
      <div class="col-lg-4 fade-in">
        <div class="why-card text-center">
          <div class="why-icon"><i class="fas fa-star"></i></div>
          <h5 class="fw-bold mt-3">Our Motto</h5>
          <p class="text-muted small fw-bold" style="font-size:1rem!important"><%= settings.motto %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5" id="values">
  <div class="container">
    <div class="text-center mb-5 fade-in">
      <h2 class="section-title">Core Values</h2>
    </div>
    <div class="row g-3 justify-content-center">
      <% [['fas fa-cross','Faith','Rooted in Catholic tradition and spiritual growth'],
          ['fas fa-book','Knowledge','Pursuit of academic excellence and lifelong learning'],
          ['fas fa-shield-alt','Discipline','Self-control, responsibility and respect'],
          ['fas fa-trophy','Excellence','Striving for the highest standards in all endeavors'],
          ['fas fa-users','Leadership','Developing future leaders for society'],
          ['fas fa-lightbulb','Innovation','Embracing creativity and modern approaches'],
          ['fas fa-heart','Character','Building moral integrity and good character'],
          ['fas fa-hands-praying','Moral Values','Living by ethical and spiritual principles']].forEach(([icon,title,desc]) => { %>
      <div class="col-lg-3 col-md-4 col-6 fade-in">
        <div class="why-card text-center">
          <div class="why-icon"><i class="<%= icon %>"></i></div>
          <h6 class="fw-bold mt-3"><%= title %></h6>
          <p class="text-muted" style="font-size:0.8rem"><%= desc %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="py-5 section-bg" id="head-teacher">
  <div class="container">
    <div class="text-center mb-5 fade-in">
      <h2 class="section-title">Message from the Head Teacher</h2>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-8 fade-in">
        <div class="card p-4 p-lg-5">
          <div class="d-flex align-items-center gap-4 mb-4">
            <% if (settings.head_teacher_image) { %>
            <img src="<%= settings.head_teacher_image %>" class="rounded-circle" style="width:90px;height:90px;object-fit:cover" alt="Head Teacher">
            <% } else { %>
            <div style="width:90px;height:90px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;flex-shrink:0">
              <i class="fas fa-user-tie"></i>
            </div>
            <% } %>
            <div>
              <h5 class="fw-bold mb-0"><%= settings.head_teacher_name %></h5>
              <span class="text-warning">Head Teacher, <%= settings.school_name %></span>
            </div>
          </div>
          <blockquote class="blockquote">
            <p class="text-muted fst-italic">"<%= settings.head_teacher_message %>"</p>
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
