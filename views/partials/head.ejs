<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= settings.school_name || 'G.S. SOVU' %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : (settings.school_tagline || 'Faith • Knowledge • Discipline • Excellence') %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : settings.school_name %>">
  <meta property="og:description" content="<%= settings.school_tagline || '' %>">
  <meta property="og:type" content="website">
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : '' %>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
