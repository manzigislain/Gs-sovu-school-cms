<footer class="pt-5 pb-0 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-3 col-md-6">
        <h5><i class="fas fa-cross me-2"></i><%= settings.school_name %></h5>
        <p style="font-size:0.85rem;color:rgba(255,255,255,0.65)"><%= settings.footer_about %></p>
        <div class="d-flex gap-3 mt-3">
          <a href="<%= settings.facebook_url || '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f fa-lg"></i></a>
          <a href="<%= settings.twitter_url || '#' %>" aria-label="Twitter"><i class="fab fa-twitter fa-lg"></i></a>
          <a href="<%= settings.youtube_url || '#' %>" aria-label="YouTube"><i class="fab fa-youtube fa-lg"></i></a>
          <a href="mailto:<%= settings.school_email %>" aria-label="Email"><i class="fas fa-envelope fa-lg"></i></a>
        </div>
      </div>
      <div class="col-lg-2 col-md-6">
        <h5>Quick Links</h5>
        <ul class="list-unstyled">
          <li class="mb-1"><a href="/about"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>About Us</a></li>
          <li class="mb-1"><a href="/academics"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Academics</a></li>
          <li class="mb-1"><a href="/admissions"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Admissions</a></li>
          <li class="mb-1"><a href="/news"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>News</a></li>
          <li class="mb-1"><a href="/gallery"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Gallery</a></li>
          <li class="mb-1"><a href="/events"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Events</a></li>
          <li class="mb-1"><a href="/contact"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Contact</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-6">
        <h5>Resources</h5>
        <ul class="list-unstyled">
          <li class="mb-1"><a href="/downloads"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Downloads</a></li>
          <li class="mb-1"><a href="/library"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Library</a></li>
          <li class="mb-1"><a href="/parents"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Parents</a></li>
          <li class="mb-1"><a href="/requirements"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Requirements</a></li>
          <li class="mb-1"><a href="/faqs"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>FAQs</a></li>
          <li class="mb-1"><a href="/fee-structure"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>School Fees</a></li>
          <li class="mb-1"><a href="/calendar"><i class="fas fa-chevron-right me-1" style="font-size:0.7rem;color:var(--secondary)"></i>Calendar</a></li>
        </ul>
      </div>
      <div class="col-lg-2 col-md-6">
        <h5>Contact Us</h5>
        <ul class="list-unstyled" style="font-size:0.85rem">
          <li class="mb-2"><i class="fas fa-map-marker-alt me-2" style="color:var(--secondary)"></i><%= settings.school_address %></li>
          <li class="mb-2"><i class="fas fa-phone me-2" style="color:var(--secondary)"></i><a href="tel:<%= settings.school_phone1 %>"><%= settings.school_phone1 %></a></li>
          <li class="mb-2"><i class="fas fa-phone me-2" style="color:var(--secondary)"></i><a href="tel:<%= settings.school_phone2 %>"><%= settings.school_phone2 %></a></li>
          <li class="mb-2"><i class="fas fa-envelope me-2" style="color:var(--secondary)"></i><a href="mailto:<%= settings.school_email %>"><%= settings.school_email %></a></li>
        </ul>
      </div>
      <div class="col-lg-3 col-md-6">
        <h5><i class="fas fa-map-marker-alt me-2"></i>Find Us</h5>
        <div class="footer-map">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12969.81541950982!2d29.694688901666606!3d-2.552736237046599!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x19c30da2753c3c03%3A0x9805dc81f7ea4ce4!2sG.S%20SOVU!5e1!3m2!1sen!2srw!4v1783253922811!5m2!1sen!2srw" width="600" height="200" style="border:0;width:100%;border-radius:8px" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom mt-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
      <span>&copy; <%= new Date().getFullYear() %> <%= settings.school_name || 'G.S. SOVU' %>. All rights reserved.</span>
      <span>
        <a href="/privacy" class="me-3">Privacy Policy</a>
        <a href="/terms" class="me-3">Terms & Conditions</a>
        <span style="color:rgba(255,255,255,0.3);font-size:0.75rem">Developed with care for education</span>
      </span>
    </div>
  </div>
</footer>

<div id="lightbox" class="lightbox">
  <button class="lightbox-close" id="lightboxClose">&times;</button>
  <img id="lightboxImg" src="" alt="Gallery Image">
</div>

<button id="backToTop" title="Back to top"><i class="fas fa-chevron-up"></i></button>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
